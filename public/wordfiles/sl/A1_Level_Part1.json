  "cards": [
    { "en": "I am here.",                    "word": "Tukaj sem. | Tu sem.",
      "note": "The pronoun is dropped; sem (I am) carries the person. Adjectives are given in the masculine; a woman says utrujena, pripravljena, bolna." },
    { "en": "You are here.",                 "word": "Tukaj si." },
    { "en": "I am tired.",                   "word": "Utrujen sem." },
    { "en": "I am ready.",                   "word": "Pripravljen sem." },
    { "en": "This is good.",                 "word": "To je dobro." },
    { "en": "That is bad.",                  "word": "Tisto je slabo. | To je slabo.",
      "note": "to = this; tisto = that over there. In speech to often covers both." },
    { "en": "I like this.",                  "word": "To mi je všeč.",
      "note": "Literally this is pleasing to me: the liked thing is the subject and the person is in the dative (mi, ti, mu)." },
    { "en": "I don't like that.",            "word": "Tisto mi ni všeč." },
    { "en": "I want this.",                  "word": "To hočem. | To bi rad.",
      "note": "hočem is direct; bi rad (I would like) is the polite everyday form, bi rada for a woman." },
    { "en": "I don't want that.",            "word": "Tistega nočem. | Tega nočem.",
      "note": "The object of a negated verb goes into the genitive: hočem to, nočem tega; imam čas, nimam časa." },
    { "en": "Do you want this?",             "word": "Hočeš to? | Ali hočeš to?" },
    { "en": "Yes, I want this.",             "word": "Ja, to hočem." },
